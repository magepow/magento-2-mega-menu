declare(strict_types=1);

/**
 * @var \Magiccart\Magicmenu\Block\Menu $block
 * @var \Magento\Framework\Escaper $escaper
 */
$menu = $block->sysCfg->topmenu;

if (!$menu['enabled']) {
    echo $block->getChildHtml();
    return;
}

$menuHtml = $block->drawMainMenu();
$mobileMenu = $menuHtml['mobile'];
$desktop = $menuHtml['desktop'];
$ids = explode(',', (string)$menu['notIncludeNav']);
foreach ($ids as $id) {
    unset($desktop[$id]);
}
$drawHomeMenu = $menu['home'] ? $block->drawHomeMenu() : '';
$drawMainMenu = $menu['mainCat'] ? implode("\n", $desktop) : '';
$drawExtraMenu = $menu['extraCat'] ? $block->drawExtraMenu() : '';

$classes = $menu['sticker'] ? 'sticker' : '';
$classes .= ($menu['fullWidth'] == 2) ? ' menufullwidth' : '';
$classes .= ' ' . $menu['event'];
?>
<nav class="navigation mean-nav navigation-mobile" role="navigation" data-action="navigation">
    <ul class="nav-mobile" data-alo-init='{"menu":{"responsive":true, "expanded":true, "position":{"my":"left top","at":"left bottom"}}}'>
        <?= /* @noEscape - HTML is escaped by Magiccart\Magicmenu\Block\Menu */ $menu['mainCat'] ? $mobileMenu : '' ?>
        <?= /* @noEscape - HTML is escaped by Magiccart\Magicmenu\Block\Menu */ $drawExtraMenu ?>
    </ul>
</nav>
<div class="magicmenu clearfix">
    <ul class="nav-desktop <?= $escaper->escapeHtmlAttr($classes) ?>"
        data-fullwidth="<?= $escaper->escapeHtmlAttr((string)$menu['fullWidth']) ?>"
        data-breakpoint="<?= $escaper->escapeHtmlAttr((string)$menu['switcher']) ?>"
        data-event="<?= $escaper->escapeHtmlAttr((string)$menu['event']) ?>"
        >
        <?= /* @noEscape - HTML is escaped by Magiccart\Magicmenu\Block\Menu */ $drawHomeMenu ?>
        <?= /* @noEscape - HTML is escaped by Magiccart\Magicmenu\Block\Menu */ $drawMainMenu ?>
        <?= /* @noEscape - HTML is escaped by Magiccart\Magicmenu\Block\Menu */ $drawExtraMenu ?>
    </ul>
</div>
<script type="text/x-magento-init">{"body": {"magicmenu": {}}}</script>
