declare(strict_types=1);

/**
 * @var \Magiccart\Magicmenu\Block\Menu $block
 * @var \Magento\Framework\Escaper $escaper
 */
$accordion = $block->sysCfg->accordion;

if (!$accordion['enabled']) {
    return;
}

$menuHtml = $block->drawMainMenu();
$mobileMenu = $menuHtml['mobile'];
?>
<div class="accordion-container">
    <div class="meanmenu-accordion" data-menu-init='{"accordion":true, "closedSign":"collapse", "openedSign":"expand", "openedActive":true}'>
        <h3 class="accor-title"><?= $escaper->escapeHtml($block->getRootName()) ?></h3>
        <ul class="accordion nav-accordion">
            <?= /* @noEscape - HTML is escaped by Magiccart\Magicmenu\Block\Menu */ $mobileMenu ?>
        </ul>
        <div class="all-cat">
            <span><?= $escaper->escapeHtml(__('All Categories')) ?></span>
            <span style="display:none"><?= $escaper->escapeHtml(__('Close')) ?></span>
        </div>
    </div>
</div>
<script type="text/x-magento-init">{"body": {"magicmenu": {}}}</script>
